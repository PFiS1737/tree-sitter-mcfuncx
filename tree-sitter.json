{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "mcfuncx",
      "camelcase": "Mcfuncx",
      "scope": "source.mcfuncx",
      "file-types": [
        "mcfunction",
        "mcfuncx"
      ],
      "injection-regex": "^mcfuncx$",
      "class-name": "TreeSitterMcfuncx"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "A tree sitter grammar for Minecraft command function",
    "authors": [
      {
        "name": "PFiS1737",
        "email": "pfis1737@gmail.com"
      }
    ],
    "links": {
      "repository": "https://github.com/PFiS1737/tree-sitter-mcfuncx"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}
